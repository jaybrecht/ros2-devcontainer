{
    "name": "ros2-jazzy",
    // Empty list: use COMPOSE_FILE from .env, same as `docker compose`.
    "dockerComposeFile": [],
    "service": "ros",
    "workspaceFolder": "/ws/src",
    "postCreateCommand": {
        // Writes Pylance's extraPaths to src/.vscode/settings.json.
        "pylance": "pylance-paths",
        // CLAUDE_CODE comes from .env. The extensions list below can't read .env, so the
        // extension is installed through the VS Code server already running in the container.
        "claude": "[ \"$CLAUDE_CODE\" != true ] || \"$(ls -td ~/.vscode-server/bin/*/ | head -1)bin/code-server\" --install-extension Anthropic.claude-code"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpp-devtools",
                "nonanonno.vscode-ros2"
            ],
            "settings": {
                "python.analysis.extraPaths": [
                    "/opt/ros/jazzy/lib/python3.12/site-packages/",
                    "/ws/install/lib/python3.12/site-packages/"
                ],

                "python.analysis.typeCheckingMode": "basic",
                "python.analysis.diagnosticSeverityOverrides": {
                    "reportAttributeAccessIssue": "none",
                    "reportMissingModuleSource": "none"
                },

                "cmake.ignoreCMakeListsMissing": true,

                "terminal.integrated.cwd": "/ws",
                "terminal.integrated.defaultProfile.linux": "zsh",

                "editor.selectionClipboard": false
            }
        }
    }
}
