# Copy to .env (not committed) and uncomment one COMPOSE_FILE line.
# Both `docker compose` and VS Code Dev Containers read it.
# Separator is ':' on Linux/WSL and ';' in Windows PowerShell/cmd.
# Linux
COMPOSE_FILE=docker-compose.yml:compose/linux.yml
# GPU lines need a one-time `sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml`,
# see compose/gpu-cdi.yml.
# COMPOSE_FILE=docker-compose.yml:compose/linux.yml:compose/gpu-cdi.yml
# COMPOSE_FILE=docker-compose.yml:compose/linux.yml:compose/gpu-cdi.yml:compose/isaacsim.yml

# Windows, repo cloned inside WSL2
# COMPOSE_FILE=docker-compose.yml:compose/windows.yml
# COMPOSE_FILE=docker-compose.yml:compose/windows.yml:compose/gpu.yml

# Windows, repo cloned on the Windows filesystem
# COMPOSE_FILE=docker-compose.yml;compose/windows.yml
# COMPOSE_FILE=docker-compose.yml;compose/windows.yml;compose/gpu.yml

# Container user. On Linux set these to the output of `id -u` and `id -g`.
# Leave at 1000 on Windows.
USER_UID=1000
USER_GID=1000

# Isaac Sim version for compose/isaacsim.yml: a tag of nvcr.io/nvidia/isaac-sim.
# Rebuild the container after changing it.
# ISAACSIM_VERSION=6.2.0

# Claude Code in the container (true/false): installs the VS Code extension and
# keeps the login in a Docker volume shared by every workspace on this machine.
# Rebuild the container after changing it.
CLAUDE_CODE=false
